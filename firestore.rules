rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cache — vain Functions kirjoittaa Admin SDK:lla (ohittaa Rules),
    // kaikki saavat lukea
    match /cache/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Veikkausliiga.com -scraped pelaajatilastot — sama periaate
    match /veikkausliiga_players/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Kaikki muu — ei sallita selaimesta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
