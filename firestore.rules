rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cache — vain Functions kirjoittaa Admin SDK:lla (ohittaa Rules),
    // kaikki saavat lukea
    match /cache/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Veikkausliiga.com -scraped pelaajatilastot — sama periaate
    match /veikkausliiga_players/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Transfermarkt-scraped pelaajaprofiilit — vain Functions kirjoittaa
    match /transfermarkt_players/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Transfermarkt name→tmId-indeksi per kausi
    match /transfermarkt_index/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // API-Football pelaajakohtainen cache (24h TTL)
    match /players_cache/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    // Kaikki muu — ei sallita selaimesta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
