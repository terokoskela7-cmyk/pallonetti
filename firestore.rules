rules_version = '2';

// ============================================================
// KAIKKI KIINNI SELAIMESTA
//
// Frontend ei kayta Firestorea suoraan. Tarkistettu webapp/src:sta:
//   - package.json:ssa ei ole firebase-riippuvuutta
//   - ei yhtaan getFirestore / collection( / doc( / onSnapshot -kutsua
//   - kaikki data haetaan fetch(API_BASE_URL + polku) eli /api:n kautta
//
// Backend kayttaa Admin SDK:ta, joka OHITTAA nama saannot. Sivusto toimii
// siis ennalleen, mutta kukaan ei paase tietokantaan suoraan selaimesta.
//
// Jos frontend joskus alkaa lukea Firestorea suoraan, lisataan vain ne
// kokoelmat ja vain lukuoikeus. Kirjoitusoikeutta ei anneta selaimelle
// missaan tapauksessa: kaikki kirjoitus kulkee tuonnin ja Admin SDK:n
// kautta, ks. CLAUDE.md kohta 3.5.
//
// Alikokoelmat kattaa {document=**}, joten seasons/{kausi}/players,
// .../tilannekuvat ja .../kansalaisuudet ovat mukana.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
